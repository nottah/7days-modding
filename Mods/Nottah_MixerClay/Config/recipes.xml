<?xml version="1.0" encoding="UTF-8"?>
<configs>
    <append xpath="/recipes">
        <!-- Clean-water option: use water already produced or boiled at the base. -->
        <recipe name="resourceClayLump" count="150" craft_time="30" craft_area="cementMixer" tags="cementMixerCrafting">
            <ingredient name="resourceCrushedSand" count="10" />
            <ingredient name="drinkJarBoiledWater" count="1" />
        </recipe>

        <!-- Murky-water option: collect water directly when clean water is scarce. -->
        <recipe name="resourceClayLump" count="150" craft_time="30" craft_area="cementMixer" tags="cementMixerCrafting">
            <ingredient name="resourceCrushedSand" count="10" />
            <ingredient name="drinkJarRiverWater" count="1" />
        </recipe>
    </append>
</configs>
